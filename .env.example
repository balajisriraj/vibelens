# Claude (default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
VIBELENS_LLM=anthropic
VIBELENS_MODEL=claude-opus-5-5

# Local speech recognition for uploads (tiny.en, base.en, small.en, medium.en ...)
VIBELENS_WHISPER_MODEL=base.en

# Run with no API key: a deterministic model that summarises and answers from the transcript itself.
# VIBELENS_LLM=scripted
# VIBELENS_SCRIPTED_DELAY=0.03
